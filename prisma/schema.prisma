generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Customers (patients / clients)
// ============================================================
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String? // billing address (optional)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([phone])
  @@index([name])
}

// ============================================================
// Patients registry
// ============================================================
model Patient {
  id          String    @id @default(cuid())
  name        String
  nic         String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices Invoice[]

  @@index([nic])
  @@index([name])
}

// ============================================================
// Locations registry (hospitals, homes, offices, airports, harbours)
// Used as invoice pickup / drop points
// ============================================================
model Location {
  id        String       @id @default(cuid())
  type      LocationType @default(OTHER)
  name      String
  address   String?
  city      String?
  phone     String?
  mapsUrl   String?
  notes     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pickupInvoices Invoice[] @relation("InvoicePickup")
  dropInvoices   Invoice[] @relation("InvoiceDrop")

  @@index([type])
  @@index([name])
}

enum LocationType {
  HOSPITAL
  HOME
  OFFICE
  AIRPORT
  HARBOUR
  OTHER
}

// ============================================================
// Invoices (generated by dispatcher, sent to customer)
// ============================================================
model Invoice {
  id             String   @id // e.g. STJ2605-1234
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  billingAddress String? // snapshot at invoice time

  description String
  serviceDate DateTime?
  vehicle     String?
  crewNotes   String?

  patientName String?
  patientNic  String?
  ward        String?
  bedNumber   String?
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Pickup / drop — registry link + snapshot so registry edits don't rewrite issued invoices
  pickupLocationId String?
  pickupLocation   Location?     @relation("InvoicePickup", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupType       LocationType?
  pickupName       String?
  pickupAddress    String?
  pickupMapsUrl    String?
  dropLocationId   String?
  dropLocation     Location?     @relation("InvoiceDrop", fields: [dropLocationId], references: [id], onDelete: SetNull)
  dropType         LocationType?
  dropName         String?
  dropAddress      String?
  dropMapsUrl      String?

  charges     InvoiceCharge[]
  totalAmount Decimal         @db.Decimal(10, 2)

  status    InvoiceStatus @default(PENDING)
  sentAt    DateTime?
  paidAt    DateTime?
  expiresAt DateTime?

  payments  Payment[]
  refunds   Refund[]
  auditLogs AuditLog[]

  createdBy String? // admin user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([patientId])
}

model InvoiceCharge {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)

  @@index([invoiceId])
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  FAILED
  CANCELLED
  ON_HOLD
  REFUNDED
  PARTIALLY_PAID
  PARTIALLY_REFUNDED
}

// ============================================================
// Payments (PayHere transaction records)
// ============================================================
model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  // PayHere order_id sent at checkout: "<invoiceId>-<attempt>" (legacy rows: "<invoiceId>")
  payhereOrderId   String? @unique
  payherePaymentId String? @unique
  amount           Decimal @db.Decimal(10, 2)
  currency         String  @default("LKR")
  method           String? // VISA, MASTER, EZCASH etc.
  statusCode       String? // PayHere status code
  statusMessage    String?

  status         PaymentStatus @default(PENDING)
  source         PaymentSource @default(PAYHERE)
  reference      String? // bank ref / receipt no. for manual payments
  note           String?
  recordedBy     String? // admin user ID for manual payments
  refundedAmount Decimal       @default(0) @db.Decimal(10, 2)
  initiatedAt    DateTime      @default(now())
  completedAt    DateTime?

  refunds Refund[]

  @@index([invoiceId])
  @@index([payhereOrderId])
}

enum PaymentSource {
  PAYHERE
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

// ============================================================
// Refunds (full via PayHere API, or partial/manual recorded by admin)
// ============================================================
model Refund {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  reason    String
  method    PaymentSource
  reference String? // PayHere payment_id or bank ref
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ============================================================
// Admin users
// ============================================================
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(DISPATCHER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]
}

// Server-side sessions — opaque session ID in cookie, actual data here.
// Middleware verifies JWT signature; layout verifies this record exists.
model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

enum AdminRole {
  SUPER_ADMIN
  DISPATCHER
  VIEWER
}

// ============================================================
// CMS content (pages / sections editable by admin)
// ============================================================
model CmsContent {
  id          String   @id // e.g. "home_hero", "about_story", "service_transport"
  title       String?
  body        String?  @db.Text
  imageUrl    String?
  imageAlt    String?
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// ============================================================
// News/Blog posts
// ============================================================
model NewsPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String    @db.Text
  imageUrl    String?
  imageAlt    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

// ============================================================
// Contact form submissions
// ============================================================
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  service   String?
  message   String   @db.Text
  hashedIp  String?
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

// ============================================================
// Audit log (PDPA-compliant — hashed IP, 90-day retention)
// ============================================================
model AuditLog {
  id            String     @id @default(cuid())
  action        String
  entityType    String?
  entityId      String?
  invoiceId     String?
  invoice       Invoice?   @relation(fields: [invoiceId], references: [id])
  actorId       String?
  actor         AdminUser? @relation(fields: [actorId], references: [id])
  hashedIp      String
  userAgentHash String
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([invoiceId])
  @@index([actorId])
}
