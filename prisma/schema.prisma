generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Customers (patients / clients)
// ============================================================
model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices    Invoice[]

  @@index([phone])
}

// ============================================================
// Invoices (generated by dispatcher, sent to customer)
// ============================================================
model Invoice {
  id          String        @id   // e.g. STJ2605-1234
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])

  description String
  serviceDate DateTime?
  vehicle     String?
  crewNotes   String?

  charges     InvoiceCharge[]
  totalAmount Decimal       @db.Decimal(10, 2)

  status      InvoiceStatus @default(PENDING)
  sentAt      DateTime?
  paidAt      DateTime?
  expiresAt   DateTime?

  payments    Payment[]
  auditLogs   AuditLog[]

  createdBy   String?       // admin user ID
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model InvoiceCharge {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)

  @@index([invoiceId])
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  FAILED
  CANCELLED
  ON_HOLD
  REFUNDED
}

// ============================================================
// Payments (PayHere transaction records)
// ============================================================
model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])

  payhereOrderId  String?       @unique
  payherePaymentId String?      @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("LKR")
  method          String?       // VISA, MASTER, EZCASH etc.
  statusCode      String?       // PayHere status code
  statusMessage   String?

  status          PaymentStatus @default(PENDING)
  initiatedAt     DateTime      @default(now())
  completedAt     DateTime?

  @@index([invoiceId])
  @@index([payhereOrderId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ============================================================
// Admin users
// ============================================================
model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(DISPATCHER)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]
}

enum AdminRole {
  SUPER_ADMIN
  DISPATCHER
  VIEWER
}

// ============================================================
// CMS content (pages / sections editable by admin)
// ============================================================
model CmsContent {
  id          String   @id   // e.g. "home_hero", "about_story", "service_transport"
  title       String?
  body        String?  @db.Text
  imageUrl    String?
  imageAlt    String?
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// ============================================================
// News/Blog posts
// ============================================================
model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  body        String   @db.Text
  imageUrl    String?
  imageAlt    String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ============================================================
// Contact form submissions
// ============================================================
model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  service     String?
  message     String   @db.Text
  hashedIp    String?
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)
}

// ============================================================
// Audit log (PDPA-compliant — hashed IP, 90-day retention)
// ============================================================
model AuditLog {
  id           String      @id @default(cuid())
  action       String
  entityType   String?
  entityId     String?
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  actorId      String?
  actor        AdminUser?  @relation(fields: [actorId], references: [id])
  hashedIp     String
  userAgentHash String
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([invoiceId])
  @@index([actorId])
}
